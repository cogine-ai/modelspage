# Public configuration. Production publishing is deliberately disabled.
MODELSPAGE_PUBLIC_BASE_URL=
MODELSPAGE_R2_ACCOUNT_ID=
MODELSPAGE_R2_BUCKET=
MODELSPAGE_PUBLISH_ENABLED=false

# Dedicated bucket-scoped credentials; never use CogineWork asset credentials.
MODELSPAGE_R2_ACCESS_KEY_ID=
MODELSPAGE_R2_SECRET_ACCESS_KEY=

# No private account catalog or inference key is required for the first release.
# A source adapter must document any future credential before introducing it.
