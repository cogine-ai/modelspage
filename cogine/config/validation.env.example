# Local-only full-provider validation credentials. Never commit this file.
# Only model-list / ranking GET requests are made; no inference calls.
# Fill only the credentials you have. Empty values remain explicit validation gaps.
# Current registration / key consoles: cogine/docs/2026-10-27-provider-accounts-and-keys.md

# C: Artificial Analysis public model scores API
MODELSPAGE_AA_API_KEY=

# P and OpenRouter catalog: one key can serve both read-only endpoints
MODELSPAGE_OPENROUTER_API_KEY=

# Provider model-list credentials (regional and plan keys remain separate)
# CogineLLM — https://llm.cogine.ai/v1
MODELSPAGE_VALIDATE_COGINELLM_API_KEY=
# Ollama Cloud — https://ollama.com/v1
MODELSPAGE_VALIDATE_OLLAMA_CLOUD_API_KEY=
# ModelScope — https://api-inference.modelscope.cn/v1
MODELSPAGE_VALIDATE_MODELSCOPE_API_KEY=
# DashScope / Alibaba Bailian — https://dashscope.aliyuncs.com/compatible-mode/v1
# Current key console: https://bailian.console.aliyun.com/cn-beijing/model/settings/api-key
MODELSPAGE_VALIDATE_DASHSCOPE_API_KEY=
# OpenAI — https://api.openai.com/v1
MODELSPAGE_VALIDATE_OPENAI_API_KEY=
# OpenAI (Response API) — https://api.openai.com/v1
MODELSPAGE_VALIDATE_OPENAI_RESPONSE_API_KEY=
# Anthropic — https://api.anthropic.com
MODELSPAGE_VALIDATE_ANTHROPIC_API_KEY=
# Google Gemini — https://generativelanguage.googleapis.com
MODELSPAGE_VALIDATE_GEMINI_API_KEY=
# DeepSeek — https://api.deepseek.com
MODELSPAGE_VALIDATE_DEEPSEEK_API_KEY=
# Kimi (China) — https://api.moonshot.cn/v1
MODELSPAGE_VALIDATE_KIMI_CN_API_KEY=
# Kimi (International) — https://api.moonshot.ai/v1
MODELSPAGE_VALIDATE_KIMI_INTL_API_KEY=
# Zhipu (BigModel) — https://open.bigmodel.cn/api/paas/v4
MODELSPAGE_VALIDATE_ZHIPU_CN_API_KEY=
# Zhipu (Z.AI) — https://api.z.ai/api/paas/v4
MODELSPAGE_VALIDATE_ZHIPU_INTL_API_KEY=
# SiliconFlow (China) — https://api.siliconflow.cn/v1
MODELSPAGE_VALIDATE_SILICONFLOW_CN_API_KEY=
# SiliconFlow (International) — https://api.siliconflow.com/v1
MODELSPAGE_VALIDATE_SILICONFLOW_INTL_API_KEY=
# Volcano Engine — https://ark.cn-beijing.volces.com/api/v3
MODELSPAGE_VALIDATE_VOLCENGINE_CN_API_KEY=

# Optional credentials for public gateway catalogs (anonymous refresh runs without these)
MODELSPAGE_VALIDATE_OPENCODE_API_KEY=
MODELSPAGE_VALIDATE_OPENCODE_GO_API_KEY=
MODELSPAGE_VALIDATE_KILO_API_KEY=
MODELSPAGE_VALIDATE_TOKENDANCE_API_KEY=

# openai-response may reuse MODELSPAGE_VALIDATE_OPENAI_API_KEY when its own value is empty.
# Local inventories and subscription OAuth are not read from user settings by this runner.
# Catalog-only Providers do not gain a model-list API by filling an API key.
